    "sql": "SELECT to_jsonb(n)-'search_document' FROM nodes n WHERE workspace_id=$1 AND kind='task' AND task_state='active' AND NOT deleted AND ($2::uuid IS NULL OR id>$2)\nAND NOT EXISTS (SELECT 1 FROM edges pc JOIN nodes child ON child.id=pc.target AND child.workspace_id=pc.workspace_id WHERE pc.workspace_id=n.workspace_id AND pc.source=n.id AND pc.edge_type='parent-child' AND NOT pc.deleted AND NOT child.deleted)\nAND NOT EXISTS (WITH RECURSIVE ancestor(id) AS (SELECT source FROM edges WHERE workspace_id=n.workspace_id AND target=n.id AND edge_type='parent-child' AND NOT deleted UNION SELECT e.source FROM edges e JOIN ancestor a ON e.target=a.id WHERE e.workspace_id=n.workspace_id AND e.edge_type='parent-child' AND NOT e.deleted) SELECT 1 FROM ancestor a JOIN nodes parent ON parent.id=a.id WHERE parent.deleted OR parent.task_state='draft')\nAND NOT EXISTS (SELECT 1 FROM edges e JOIN nodes prerequisite ON prerequisite.id=e.source WHERE e.workspace_id=n.workspace_id AND e.target=n.id AND e.edge_type='blocks' AND NOT e.deleted AND (prerequisite.deleted OR prerequisite.task_state IS DISTINCT FROM 'completed')) ORDER BY id LIMIT $3",
    "literal_sql": "SELECT to_jsonb(n)-'search_document' FROM nodes n WHERE workspace_id='00000000-0000-4000-8000-000000000002'::uuid AND kind='task' AND task_state='active' AND NOT deleted AND (NULL::uuid IS NULL OR id>NULL)\nAND NOT EXISTS (SELECT 1 FROM edges pc JOIN nodes child ON child.id=pc.target AND child.workspace_id=pc.workspace_id WHERE pc.workspace_id=n.workspace_id AND pc.source=n.id AND pc.edge_type='parent-child' AND NOT pc.deleted AND NOT child.deleted)\nAND NOT EXISTS (WITH RECURSIVE ancestor(id) AS (SELECT source FROM edges WHERE workspace_id=n.workspace_id AND target=n.id AND edge_type='parent-child' AND NOT deleted UNION SELECT e.source FROM edges e JOIN ancestor a ON e.target=a.id WHERE e.workspace_id=n.workspace_id AND e.edge_type='parent-child' AND NOT e.deleted) SELECT 1 FROM ancestor a JOIN nodes parent ON parent.id=a.id WHERE parent.deleted OR parent.task_state='draft')\nAND NOT EXISTS (SELECT 1 FROM edges e JOIN nodes prerequisite ON prerequisite.id=e.source WHERE e.workspace_id=n.workspace_id AND e.target=n.id AND e.edge_type='blocks' AND NOT e.deleted AND (prerequisite.deleted OR prerequisite.task_state IS DISTINCT FROM 'completed')) ORDER BY id LIMIT 21",
    "sql_note": "Correlated ancestor predicate captured from the pre-fix running binary/source; all surrounding predicates were unchanged."
